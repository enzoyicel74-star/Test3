-- 5. VOID HIDE
-- =============================================================================
local VoidHideConfig = {Enabled = false, Height = 50000, Transparency = 0.8, GhostMode = true, NoCollision = true, HideName = false}
local OriginalTransparency, OriginalParent, OriginalCanCollide, OriginalName = {}, nil, {}, nil
local function HideCharacter()
    if not LocalCharacter or OriginalParent then return end
    OriginalParent = LocalCharacter.Parent
    for _, d in ipairs(LocalCharacter:GetDescendants()) do
        if d:IsA("BasePart") then OriginalTransparency[d] = d.Transparency; OriginalCanCollide[d] = d.CanCollide; d.Transparency = VoidHideConfig.GhostMode and VoidHideConfig.Transparency or 1; d.CanCollide = not VoidHideConfig.NoCollision end
    end
    LocalCharacter.Parent = Workspace.Terrain
    if RootPart then RootPart.CFrame = CFrame.new(0, VoidHideConfig.Height, 0) end
end
local function ShowCharacter()
    if not LocalCharacter or not OriginalParent then return end
    for part, t in pairs(OriginalTransparency) do if part then part.Transparency = t; part.CanCollide = OriginalCanCollide[part] end end
    LocalCharacter.Parent = OriginalParent; OriginalParent = nil
end
local function UpdateVoidHide()
    if not RootPart then return end
    if VoidHideConfig.Enabled then if not OriginalParent then HideCharacter() end else if OriginalParent then ShowCharacter() end end
end

