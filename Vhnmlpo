local RagebotConfig = {
    Enabled = false,
    Teleport = true,           -- Teleport to enemy
    ShootThroughWalls = true,  -- Ignore walls
    AutoShoot = true,          -- Shoot automatically
    Range = 1000,              -- Max detection range
    Distance = 15,             -- Teleport distance from enemy
    WeaponMode = "Premier",    -- Premier / Secondary / Melee
    SilentAim = false,         -- Silent aim mode
    AimPart = "Head",          -- Aim at: Head, Torso, HumanoidRootPart
    PredictionAmount = 0.15,   -- Built-in prediction
    Delay = 0.1,               -- Time between shots
    IgnoreTeam = true,         -- Ignore teammates
    AimKey = Enum.UserInputType.MouseButton1,
    AlwaysActive = false
}

local LastShot = 0

-- Get Remote/Weapon
local function GetWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildWhichIsA("Tool") or (backpack and backpack:FindFirstChildWhichIsA("Tool"))
    return tool
end

-- Get Aim Position
local function GetAimPosition(player)
    local char = player.Character
    if not char then return nil end
    local part = char:FindFirstChild(RagebotConfig.AimPart) or char:FindFirstChild("HumanoidRootPart")
    return part and part.Position
end

-- Ragebot Main Logic
local function UpdateRagebot()
    if not RootPart or not RagebotConfig.Enabled then return end
    
    local target = GetClosestPlayer(RagebotConfig.Range)
    if not target then return end
    
    -- Teleport to enemy
    if RagebotConfig.Teleport then
        local targetPos = GetAimPosition(target)
        if targetPos then
            pcall(function()
                local dir = (targetPos - RootPart.Position).Unit * RagebotConfig.Distance
                RootPart.CFrame = CFrame.new(targetPos - dir)
            end)
        end
    end
    
    -- Auto Shoot
    if RagebotConfig.AutoShoot and os.clock() - LastShot >= RagebotConfig.Delay then
        LastShot = os.clock()
        local weapon = GetWeapon()
        if weapon then
            pcall(function()
                -- Fire weapon/remote
                local args = {[1] = target, [2] = GetAimPosition(target)}
                -- Wall penetration: ignore raycast filtering
                if RagebotConfig.ShootThroughWalls then
                    -- Direct fire — no raycast blocking
                    FireServerEvent = ReplicatedStorage:FindFirstChild("RemoteEvent") or ReplicatedStorage:FindFirstChildWhichIsA("RemoteEvent")
                    if FireServerEvent then FireServerEvent:FireServer(unpack(args)) end
                else
                    -- Normal fire
                    FireServerEvent = ReplicatedStorage:FindFirstChild("RemoteEvent") or ReplicatedStorage:FindFirstChildWhichIsA("RemoteEvent")
                    if FireServerEvent then FireServerEvent:FireServer(unpack(args)) end
                end
            end)
        end
    end
end

-- =============================================================================
-- 🎯 PREDICTION SYSTEM
-- =============================================================================
local PredictionConfig = {
    Enabled = false,
    Amount = 0.15,
    VelocityBased = true,
    Vertical = true,
    Smoothness = 0.5
}
local PlayerVelocity = {}

local function UpdatePlayerVelocity(player)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local state = PlayerVelocity[player] or {LastPos = hrp.Position, LastTime = os.clock()}
    local now = os.clock()
    local dt = now - state.LastTime
    if dt > 0 then state.Velocity = (hrp.Position - state.LastPos) / dt end
    state.LastPos = hrp.Position
    state.LastTime = now
    PlayerVelocity[player] = state
end

local function GetPredictedPosition(player, timeOffset)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    UpdatePlayerVelocity(player)
    local state = PlayerVelocity[player]
    if not state or not state.Velocity or not PredictionConfig.Enabled then return hrp.Position end
    local predicted = hrp.Position + state.Velocity * (timeOffset or PredictionConfig.Amount)
    if not PredictionConfig.Vertical then predicted = Vector3.new(predicted.X, hrp.Position.Y, predicted.Z) end
    return predicted
end

-- =============================================================================
-- 🛡️ ANTI AIM
-- =============================================================================
local AntiAimConfig = {
    Enabled = false,
    Mode = "Spin",
    SpinSpeed = 180,
    JitterAmount = 45,
    BackwardsOffset = 180,
    Randomize = true
}
local AntiAimAngle = 0

local function UpdateAntiAim(dt)
    if not RootPart or not AntiAimConfig.Enabled then return end
    AntiAimAngle += math.rad(AntiAimConfig.SpinSpeed) * dt
    local finalAngle = 0
    if AntiAimConfig.Mode == "Spin" then finalAngle = AntiAimAngle
    elseif AntiAimConfig.Mode == "Jitter" then finalAngle = math.rad(math.random(-AntiAimConfig.JitterAmount, AntiAimConfig.JitterAmount))
    elseif AntiAimConfig.Mode == "Backwards" then finalAngle = math.rad(AntiAimConfig.BackwardsOffset + (AntiAimConfig.Randomize and math.random(-15,15) or 0)) end
    pcall(function()
        RootPart.CFrame = CFrame.new(RootPart.Position, RootPart.Position + Vector3.new(math.cos(finalAngle), 0, math.sin(finalAngle)))
    end)
end

