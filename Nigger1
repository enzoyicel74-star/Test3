        local playerDataController = controllers:WaitForChild("PlayerDataController", 15)
        if playerDataController then
            local success, DataController = pcall(require, playerDataController)
            if success and DataController then
                local timeout = 0
                while not DataController.CurrentData and timeout < 30 do
                    task.wait(0.5)
                    timeout = timeout + 1
                end
            end
        end
    end

    repeat task.wait(0.5) until LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer:FindFirstChild("PlayerGui")

    task.wait(1.5)

    pcall(function()
        SaveManager:LoadAutoloadConfig()
    end)

    task.wait(0.3)

    UpdateConfig()
    ApplySpoofs()

    if Controls.unlockWeaponsToggle and Controls.unlockWeaponsToggle.Value then
        task.defer(ExecuteUnlockWeapons)
    end

    if Controls.unlockSkinsToggle and Controls.unlockSkinsToggle.Value then
        task.defer(ExecuteUnlockSkins)
    end
end)

