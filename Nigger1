            lighting.Shadows = originalLighting.Shadows
        else
            lighting.Shadows = true
        end
        Library:Notify("No Shadows disabled", 2)
    end
end

-- ===== MUTE AMBIENT =====
local function ApplyMuteAmbient(enabled)
    local soundService = game:GetService("SoundService")
    if enabled then
        if originalAmbientVolume == nil then
            originalAmbientVolume = soundService.AmbientVolume
        end
        soundService.AmbientVolume = 0
        Library:Notify("Ambient sounds muted", 2)
    else
        if originalAmbientVolume ~= nil then
            soundService.AmbientVolume = originalAmbientVolume
        else
            soundService.AmbientVolume = 1
        end
        Library:Notify("Ambient sounds restored", 2)
    end
end

-- ===== CLEAR SKY =====
local function ApplyClearSky(enabled)
    if clearSkyConnection then
        clearSkyConnection:Disconnect()
        clearSkyConnection = nil
    end
    local lighting = game:GetService("Lighting")
    if enabled then
        -- Save original skybox and ambient if not saved
        if originalLighting.SkyboxBk == nil then
            originalLighting.SkyboxBk = lighting.SkyboxBk
            originalLighting.SkyboxDn = lighting.SkyboxDn
            originalLighting.SkyboxFt = lighting.SkyboxFt
            originalLighting.SkyboxLf = lighting.SkyboxLf
            originalLighting.SkyboxRt = lighting.SkyboxRt
            originalLighting.SkyboxUp = lighting.SkyboxUp
            originalLighting.Ambient = lighting.Ambient
            originalLighting.Brightness = lighting.Brightness
        end
        -- Remove any existing Sky object
        local skyObj = lighting:FindFirstChild("Sky")
        if skyObj then skyObj:Destroy() end

        -- Set skybox to transparent and adjust ambient to blue
        lighting.SkyboxBk = "rbxassetid://0"
        lighting.SkyboxDn = "rbxassetid://0"
        lighting.SkyboxFt = "rbxassetid://0"
        lighting.SkyboxLf = "rbxassetid://0"
        lighting.SkyboxRt = "rbxassetid://0"
        lighting.SkyboxUp = "rbxassetid://0"
        lighting.Ambient = Color3.new(0.5, 0.7, 1)
        lighting.Brightness = 3

        -- Persistent loop to keep it applied (some games reset)
        clearSkyConnection = game:GetService("RunService").RenderStepped:Connect(function()
            if not VisualState.clearSky then
                clearSkyConnection:Disconnect()
                clearSkyConnection = nil
                return
            end
            lighting.SkyboxBk = "rbxassetid://0"
            lighting.SkyboxDn = "rbxassetid://0"
            lighting.SkyboxFt = "rbxassetid://0"
            lighting.SkyboxLf = "rbxassetid://0"
            lighting.SkyboxRt = "rbxassetid://0"
            lighting.SkyboxUp = "rbxassetid://0"
            lighting.Ambient = Color3.new(0.5, 0.7, 1)
            lighting.Brightness = 3
        end)
        Library:Notify("Clear Sky enabled", 2)
    else
        if originalLighting.SkyboxBk then
            lighting.SkyboxBk = originalLighting.SkyboxBk
            lighting.SkyboxDn = originalLighting.SkyboxDn
            lighting.SkyboxFt = originalLighting.SkyboxFt
            lighting.SkyboxLf = originalLighting.SkyboxLf
            lighting.SkyboxRt = originalLighting.SkyboxRt
            lighting.SkyboxUp = originalLighting.SkyboxUp
            lighting.Ambient = originalLighting.Ambient
            lighting.Brightness = originalLighting.Brightness
        end
        Library:Notify("Clear Sky disabled", 2)
    end
end

-- ===== FOV SLIDER =====
local function ApplyFOV(value)
    local camera = workspace.CurrentCamera
    if not camera then return end
    camera.FieldOfView = value
    -- Persistent connection to keep FOV
    if fovConnection then
        fovConnection:Disconnect()
        fovConnection = nil
    end
    fovConnection = game:GetService("RunService").RenderStepped:Connect(function()
        if camera and camera.FieldOfView ~= VisualState.fov then
            camera.FieldOfView = VisualState.fov
        end
    end)
end

