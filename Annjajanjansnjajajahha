-- 5. VOID HIDE — ✅ SCALES FIXED • SMOOTH RANGES
-- =============================================================================
local VoidHideConfig = {
    Enabled = false,
    Height = 50000,
    Transparency = 0.8,
    GhostMode = true,
    NoCollision = true,
    HideName = false
}
local OriginalTransparency, OriginalParent = {}, nil
local OriginalCanCollide, OriginalName = {}, nil

local function HideCharacter()
    if not LocalCharacter or OriginalParent then return end
    OriginalParent = LocalCharacter.Parent
    OriginalTransparency = {}
    OriginalCanCollide = {}
    
    for _, d in ipairs(LocalCharacter:GetDescendants()) do
        if d:IsA("BasePart") then
            OriginalTransparency[d] = d.Transparency
            OriginalCanCollide[d] = d.CanCollide
            d.Transparency = VoidHideConfig.GhostMode and VoidHideConfig.Transparency or 1
            d.CanCollide = not VoidHideConfig.NoCollision
        end
    end
    
    if VoidHideConfig.HideName then
        local hum = LocalCharacter:FindFirstChild("Humanoid")
        if hum then OriginalName = hum.DisplayName; hum.DisplayName = "" end
    end
    
    LocalCharacter.Parent = Workspace.Terrain
    if RootPart then RootPart.CFrame = CFrame.new(0, VoidHideConfig.Height, 0) end
end

local function ShowCharacter()
    if not LocalCharacter or not OriginalParent then return end
    for part, t in pairs(OriginalTransparency) do
        if part and part:IsDescendantOf(Workspace) then
            part.Transparency = t
            part.CanCollide = OriginalCanCollide[part]
        end
    end
    if OriginalName then
        local hum = LocalCharacter:FindFirstChild("Humanoid")
        if hum then hum.DisplayName = OriginalName end
    end
    OriginalTransparency, OriginalCanCollide, OriginalParent, OriginalName = {}, {}, nil, nil
    LocalCharacter.Parent = OriginalParent
end

local function UpdateVoidHide()
    if not RootPart then return end
    if VoidHideConfig.Enabled then
        if not OriginalParent then HideCharacter() end
        pcall(function() RootPart.CFrame = CFrame.new(0, VoidHideConfig.Height, 0) end)
    else
        if OriginalParent then ShowCharacter() end
    end
end

