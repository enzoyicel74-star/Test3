-- 1. VOID SPAM — ✅ SCALES FIXED • SMOOTH RANGES
-- =============================================================================
local VoidConfig = {
    Enabled = false,
    Speed = 5000,
    Altitude = 50000,
    SpinSpeed = 0,
    Gravity = 0,
    RandomX = true,
    RandomY = true,
    RandomZ = true
}

local function UpdateVoidSpam()
    if not RootPart or not VoidConfig.Enabled then return end
    pcall(function()
        local vx = VoidConfig.RandomX and (math.random()-0.5)*VoidConfig.Speed or 0
        local vy = VoidConfig.RandomY and (math.random()-0.5)*VoidConfig.Speed or VoidConfig.Gravity
        local vz = VoidConfig.RandomZ and (math.random()-0.5)*VoidConfig.Speed or 0
        
        RootPart.CFrame = CFrame.new(RootPart.Position.X, VoidConfig.Altitude, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
        
        if VoidConfig.SpinSpeed > 0 then
            RootPart.CFrame *= CFrame.Angles(0, math.rad(VoidConfig.SpinSpeed)*os.clock(), 0)
        end
    end)
end

-- =============================================================================
-- 2. ORBIT — ✅ SCALES FIXED • SMOOTH RANGES
-- =============================================================================
local OrbitConfig = {
    Enabled = false,
    Speed = 360,
    Radius = 30,
    Height = 5,
    Tilt = 0,
    Range = 500,
    Smoothness = 1
}
local OrbitAngle = 0

local function UpdateOrbit(dt)
    if not RootPart or not OrbitConfig.Enabled then return end
    local target = GetClosestPlayer(OrbitConfig.Range)
    local hrp = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    OrbitAngle += math.rad(OrbitConfig.Speed) * dt * OrbitConfig.Smoothness
    local x = math.cos(OrbitAngle) * OrbitConfig.Radius
    local z = math.sin(OrbitAngle) * OrbitConfig.Radius
    local offset = Vector3.new(x, OrbitConfig.Height, z)
    
    if OrbitConfig.Tilt ~= 0 then
        pcall(function() RootPart.CFrame = CFrame.new(hrp.Position + offset) * CFrame.Angles(math.rad(OrbitConfig.Tilt), 0, 0) end)
    else
        pcall(function() RootPart.CFrame = CFrame.new(hrp.Position + offset) end)
    end
end

-- =============================================================================
-- 3. TRANSLOCATE — ✅ SCALES FIXED • SMOOTH RANGES
-- =============================================================================
local TranslocateConfig = {
    Enabled = false,
    Range = 1000,
    Offset = 5,
    MinDistance = 15,
    Lift = 0
}

local function UpdateTranslocate()
    if not RootPart or not TranslocateConfig.Enabled then return end
    local target = GetClosestPlayer(TranslocateConfig.Range)
    local hrp = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local dist = (RootPart.Position - hrp.Position).Magnitude
    if dist < TranslocateConfig.MinDistance then return end
    
    pcall(function()
        local dir = (hrp.Position - RootPart.Position).Unit * TranslocateConfig.Offset
        RootPart.CFrame = CFrame.new(hrp.Position - dir + Vector3.new(0, TranslocateConfig.Lift, 0))
    end)
end

-- =============================================================================
-- 4. EVADE — ✅ SCALES FIXED • SMOOTH RANGES
-- =============================================================================
local EvadeConfig = {
    Enabled = false,
    Distance = 200,
    Delay = 1.5,
    MinHeight = -50,
    MaxHeight = 150,
    Direction = 360
}
local LastEvade = os.clock()

local function EvadeOnce()
    if not RootPart then return end
    LastEvade = os.clock()
    local angle = EvadeConfig.Direction == 360 and math.random() * math.pi * 2 or math.rad(EvadeConfig.Direction)
    local y = math.random(EvadeConfig.MinHeight, EvadeConfig.MaxHeight)
    pcall(function()
        RootPart.CFrame = CFrame.new(RootPart.Position + Vector3.new(
            math.cos(angle) * EvadeConfig.Distance,
            y,
            math.sin(angle) * EvadeConfig.Distance
        ))
    end)
end

local function UpdateEvade()
    if not RootPart or not EvadeConfig.Enabled then return end
    if os.clock() - LastEvade >= EvadeConfig.Delay then EvadeOnce() end
end

