-- GET CLOSEST PLAYER
local function GetClosestPlayer(maxRange)
    if not RootPart then return nil end
    maxRange = maxRange or math.huge
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local dist = (RootPart.Position - hrp.Position).Magnitude
            if dist < bestDist and dist <= maxRange then
                bestDist, best = dist, p
            end
        end
    end
    return best
end

-- =============================================================================
-- 🔥 VOID KILLER
-- =============================================================================
local VoidKillerConfig = {
    Enabled = false,
    MinHeight = 5000,
    MinSpeed = 1000,
    CheckInterval = 0.5,
    KillMode = "Kill"
}
local PlayerStates = {}

local function KillPlayer(player)
    local hum = player.Character and player.Character:FindFirstChild("Humanoid")
    if hum then pcall(function() hum.Health = 0 end) end
    print("[VOID KILLER] Killed: " .. player.Name)
    if UI_Loaded then Library:Notify("Killed voider: " .. player.Name, 3) end
end

local function KickPlayer(player)
    pcall(function() player:Kick("[VOID DETECTED] - Exploiting detected") end)
end

local function UpdateVoidKiller()
    if not VoidKillerConfig.Enabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local state = PlayerStates[p] or {LastPos = hrp.Position, LastTime = os.clock()}
        local now = os.clock()
        local dt = now - state.LastTime
        if dt >= VoidKillerConfig.CheckInterval then
            if hrp.Position.Y > VoidKillerConfig.MinHeight then
                print("[VOID KILLER] " .. p.Name .. " TOO HIGH")
                if VoidKillerConfig.KillMode == "Kill" then KillPlayer(p) else KickPlayer(p) end
            end
            local speed = (hrp.Position - state.LastPos).Magnitude / dt
            if speed > VoidKillerConfig.MinSpeed then
                print("[VOID KILLER] " .. p.Name .. " TOO FAST")
                if VoidKillerConfig.KillMode == "Kill" then KillPlayer(p) else KickPlayer(p) end
            end
            state.LastPos = hrp.Position
            state.LastTime = now
        end
        PlayerStates[p] = state
    end
end

