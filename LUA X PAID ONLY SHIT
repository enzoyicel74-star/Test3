end
warn("[faulmor] DIAG 4: stage2 response len=" .. tostring(#tostring(resp)))
_diag("stage2_response", {h_len = #hwid, k_len = #script_key})

-- Parse JSON response
local data_ok, data = pcall(function() return hs:JSONDecode(resp) end)
if not data_ok then
    _diag("stage2_json_failed", {h_len = #hwid, k_len = #script_key})
    warn("[faulmor] DIAG 5: JSON decode failed")
    return
end
if type(data) ~= "table" then
    warn("[faulmor] DIAG 5: response not a table")
    return
end
if data.e then
    _diag("stage2_auth_error", {h_len = #hwid, k_len = #script_key})
    warn("[faulmor] auth error: " .. tostring(data.e))
    return
end
warn("[faulmor] DIAG 6: stage2 ok, has_u=" .. tostring(data.u ~= nil) .. " has_c=" .. tostring(data.c ~= nil))

local src = ""

-- Stage2 provides either a 'u' (stage3 URL) or a 'c' (combo cipher)
if data.u and data.t and data.n and data.k then
    warn("[faulmor] DIAG 7: normal stage3 path")
    local stage3_body = hs:JSONEncode({n = data.n, t = data.t, h = hwid})
    local resp3, ok3 = _transport(data.u, "POST", stage3_body)
    if not ok3 or not resp3 or resp3 == "" then
        warn("[faulmor] fetch failed")
        return
    end
    warn("[faulmor] DIAG 8: stage3 response len=" .. tostring(#tostring(resp3)))
    local ok_raw, raw = pcall(b64decode, resp3)
    if not ok_raw then
        warn("[faulmor] DIAG 9: b64decode failed")
        return
    end
    local k3 = ""
    for i = 1, #data.k, 2 do k3 = k3 .. string.char(tonumber(data.k:sub(i, i + 1), 16) or 0) end
    local ok_dec, decoded = pcall(decode_stage, raw, k3)
    if not ok_dec then
        warn("[faulmor] DIAG 10: decode_stage failed")
        return
    end
    src = decoded or ""

elseif data.n and data.k and data.c then
    warn("[faulmor] DIAG 7: combo path")
    local ok_raw, raw = pcall(b64decode, data.c)
    if not ok_raw then
        warn("[faulmor] DIAG 9: b64decode failed")
        return
    end
    warn("[faulmor] DIAG 8: combo cipher len=" .. tostring(#tostring(raw)))
    local k3 = ""
    for i = 1, #data.k, 2 do k3 = k3 .. string.char(tonumber(data.k:sub(i, i + 1), 16) or 0) end
    local ok_dec, decoded = pcall(decode_stage, raw, k3)
    if not ok_dec then
        warn("[faulmor] DIAG 10: decode_stage failed")
        return
    end
    src = decoded or ""
else
    warn("[faulmor] DIAG 7: unknown stage2 shape")
    return
end

warn("[faulmor] DIAG 11: src len=" .. tostring(#src))
if src == "" then
    warn("[faulmor] empty payload after decode")
    return
end

