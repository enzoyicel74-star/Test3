-- Get HWID (RbxAnalyticsService ClientId)
local function gethwid()
    local h = "unknown"
    if game ~= nil and type(game.GetService) == 'function' then
        pcall(function()
            local ra = game:GetService("RbxAnalyticsService")
            if ra and type(ra.GetClientId) == 'function' then h = ra:GetClientId() end
        end)
    end
    return h
end

-- XOR (fallback for bit32)
local function _bxor(a, b)
    if bit32 and bit32.bxor then return bit32.bxor(a, b) end
    if bit and bit.bxor then return bit.bxor(a, b) end
    local r, p = 0, 1
    for _ = 1, 8 do
        local x, y = a % 2, b % 2
        if x ~= y then r = r + p end
        a, b, p = (a - x) / 2, (b - y) / 2, p * 2
    end
    return r
end

-- Decrypt stage payload using key and drift
local function decode_stage(data, key)
    local out = {}
    local kl = #key
    if kl == 0 then return "" end
    local kb = {}
    for i = 1, kl do kb[i] = string.byte(key, i) end
    for i = 1, #data do
        local db_i = string.byte(data, i)
        local ki = kb[((i - 1) % kl) + 1]
        local drift = ((i * 131 + math.floor((i - 1) / kl)) % 256)
        out[i] = string.char(_bxor(db_i, _bxor(ki, drift)))
    end
    return table.concat(out)
end

-- Base64 decode
local function b64decode(d)
    local b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
    local t = {}
    for i = 1, #b do t[b:sub(i, i)] = i - 1 end
    d = d:gsub('[^%a%d%+/=]', '')
    local out, val, bits = {}, 0, 0
    for i = 1, #d do
        local c = d:sub(i, i)
        if c == '=' then break end
        local f = t[c]
        if f then
            if bit32 and bit32.lshift then
                val = bit32.lshift(val, 6) + f
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    table.insert(out, string.char(bit32.rshift(val, bits)))
                    val = bit32.band(val, bit32.lshift(1, bits) - 1)
                end
            else
                val = val * 64 + f
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    local shift = 2 ^ bits
                    table.insert(out, string.char(math.floor(val / shift) % 256))
                    val = val % shift
                end
            end
        end
    end
    return table.concat(out)
end

-- Find script key from environment or script attribute
local function _resolve_key()
    local names = {"faulmor_key","script_key","Key","scriptkey","loader_key","FAULMOR_KEY"}
    local envs = {}
    if type(getgenv) == 'function' then table.insert(envs, getgenv()) end
    if type(getrenv) == 'function' then table.insert(envs, getrenv()) end
    if type(getfenv) == 'function' then
        pcall(function() table.insert(envs, getfenv(0)) end)
        pcall(function() table.insert(envs, getfenv(1)) end)
    end
    table.insert(envs, _G)
    for _, env in ipairs(envs) do
        if type(env) == 'table' then
            for _, name in ipairs(names) do
                local v = rawget(env, name)
                if type(v) == 'string' then
                    local clean = _sanitize(v)
                    if clean ~= '' then return clean end
                end
            end
        end
    end
    if script and type(script) == 'userdata' then
        pcall(function()
            local attr = script:GetAttribute("faulmor_key") or script:GetAttribute("script_key")
            if type(attr) == 'string' then
                local clean = _sanitize(attr)
                if clean ~= '' then return clean end
            end
        end)
    end
    return ""
end

-- Main flow
local script_key = _resolve_key()
local hwid = _sanitize(gethwid())
