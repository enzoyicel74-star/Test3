local _rw, _rp = warn, print
local warn = function(m, ...)
    if type(m) == 'string' and m:sub(1, 9) == '[faulmor]' then return end
    return _rw(m, ...)
end
local print = function(m, ...)
    if type(m) == 'string' and m:sub(1, 9) == '[faulmor]' then return end
    return _rp(m, ...)
end

local _G = (type(getgenv) == 'function' and getgenv()) or _G
local hs = (game ~= nil and type(game.GetService) == 'function' and game:GetService("HttpService"))

warn("[faulmor] DIAG 1: stage1 bootstrap started")

-- Utility: sanitize strings
local function _sanitize(s)
    if type(s) ~= 'string' then return "" end
    local clean = s:gsub("^%s*(.-)%s$", "%1")
    clean = clean:gsub('^"', ''):gsub('"$', ''):gsub("^'", ''):gsub("'$", '')
    clean = clean:gsub("[%s%z-]", "")
    local lower = clean:lower()
    if lower == "nil" or lower == "null" or lower == "undefined" or lower == "unknown" then
        return ""
    end
    return clean
end

-- HTTP transport (tries multiple executors)
local function _transport(url, method, body, headers)
    local _req = _G.request or (type(syn) == 'table' and syn.request) or (type(http) == 'table' and http.request) or (type(fluxus) == 'table' and fluxus.request)
    if _req then
        warn("[faulmor] REQUEST " .. tostring(method) .. " stage2/transport")
        local success, response = pcall(_req, {
            Url = url,
            Method = method,
            Headers = headers or {["Content-Type"] = "application/json"},
            Body = body
        })
        if success and response then
            return response.Body, true, response.StatusCode or 0
        end
    end
    if hs then
        if method == "POST" then
            local success, response = pcall(hs.PostAsync, hs, url, body, Enum.HttpContentType.ApplicationJson, false)
            if success then return response, true, 200 end
            return response, false, 500
        else
            local success, response = pcall(hs.GetAsync, hs, url, true)
            if success then return response, true, 200 end
            return response, false, 500
        end
    end
    return nil, false, 0
end

