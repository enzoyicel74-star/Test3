end
local stage2_url = "https://faulmor.site/api/public/loaders/57e975a5c72bc6917160c5ef0e673728/stage2?" .. s2_params
local body_json = hs:JSONEncode({h = hwid, p = script_key})

warn("[faulmor] DIAG 3: posting stage2")
