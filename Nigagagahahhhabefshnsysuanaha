-- 🛡️ ANTI AIM
-- =============================================================================
local AntiAim = {Enabled = false, Mode = "Spin", Speed = 180, Jitter = 45}
local AntiAimAngle = 0

local function UpdateAntiAim(dt)
    if not RootPart or not AntiAim.Enabled then return end
    AntiAimAngle += math.rad(AntiAim.Speed) * dt
    local ang = 0
    if AntiAim.Mode == "Spin" then ang = AntiAimAngle
    elseif AntiAim.Mode == "Jitter" then ang = math.rad(math.random(-AntiAim.Jitter, AntiAim.Jitter)) end
    pcall(function()
        RootPart.CFrame = CFrame.new(RootPart.Position) * CFrame.Angles(0, ang, 0)
    end)
end

-- =============================================================================
-- ⬆️ VOID SPAM
-- =============================================================================
local VoidSpam = {Enabled = false, Speed = 5000, Height = 50000, Spin = 0}
local function UpdateVoidSpam()
    if not RootPart or not VoidSpam.Enabled then return end
    pcall(function()
        RootPart.CFrame = CFrame.new(RootPart.Position.X, VoidSpam.Height, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.new(
            (math.random()-0.5)*VoidSpam.Speed,
            (math.random()-0.5)*VoidSpam.Speed,
            (math.random()-0.5)*VoidSpam.Speed
        )
        if VoidSpam.Spin > 0 then
            RootPart.CFrame *= CFrame.Angles(0, math.rad(VoidSpam.Spin)*os.clock(), 0)
        end
    end)
end

-- =============================================================================
-- 🌀 ORBIT
-- =============================================================================
local Orbit = {Enabled = false, Speed = 90, Radius = 30, Height = 5, Range = 500}
local OrbitAngle = 0
local function UpdateOrbit(dt)
    if not RootPart or not Orbit.Enabled then return end
    local target = GetClosestEnemy(Orbit.Range)
    if not target or not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    OrbitAngle += math.rad(Orbit.Speed) * dt
    local x, z = math.cos(OrbitAngle)*Orbit.Radius, math.sin(OrbitAngle)*Orbit.Radius
    pcall(function()
        RootPart.CFrame = CFrame.new(hrp.Position + Vector3.new(x, Orbit.Height, z))
    end)
end

-- =============================================================================
-- 🎯 TRANSLOCATE
-- =============================================================================
local Translocate = {Enabled = false, Range = 1000, Dist = 8, MinDist = 15}
local function UpdateTranslocate()
    if not RootPart or not Translocate.Enabled then return end
    local target = GetClosestEnemy(Translocate.Range)
    if not target or not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (RootPart.Position - hrp.Position).Magnitude
    if dist < Translocate.MinDist then return end
    pcall(function()
        local dir = (hrp.Position - RootPart.Position).Unit * Translocate.Dist
        RootPart.CFrame = CFrame.new(hrp.Position - dir)
    end)
end

-- =============================================================================
-- 💨 EVADE
-- =============================================================================
local Evade = {Enabled = false, Dist = 200, Delay = 1.5}
local LastEvade = 0
local function EvadeNow()
    if not RootPart then return end
    LastEvade = os.clock()
    local ang = math.random() * math.pi * 2
    pcall(function()
        RootPart.CFrame = CFrame.new(RootPart.Position + Vector3.new(math.cos(ang)*Evade.Dist, 0, math.sin(ang)*Evade.Dist))
    end)
end
local function UpdateEvade()
    if not RootPart or not Evade.Enabled then return end
    if os.clock() - LastEvade >= Evade.Delay then EvadeNow() end
end

-- =============================================================================
-- 👻 VOID HIDE
-- =============================================================================
local VoidHide = {Enabled = false, Height = 50000}
local OriginalParent = nil
local TransparencyCache = {}

local function HideMe()
    if not LocalCharacter or OriginalParent then return end
    OriginalParent = LocalCharacter.Parent
    for _, d in ipairs(LocalCharacter:GetDescendants()) do
        if d:IsA("BasePart") then
            TransparencyCache[d] = d.Transparency
            d.Transparency = 1
        end
    end
    LocalCharacter.Parent = Workspace.Terrain
    if RootPart then RootPart.CFrame = CFrame.new(0, VoidHide.Height, 0) end
end

local function ShowMe()
    if not LocalCharacter or not OriginalParent then return end
    for part, t in pairs(TransparencyCache) do
        if part then part.Transparency = t end
    end
    LocalCharacter.Parent = OriginalParent
    OriginalParent = nil
    table.clear(TransparencyCache)
end

local function UpdateVoidHide()
    if VoidHide.Enabled then HideMe() else ShowMe() end
end

