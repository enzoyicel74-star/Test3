-- 🔫 RAGEBOT — FULLY WORKING
-- =============================================================================
local Ragebot = {
    Enabled = false,
    Mode = "Gun",              -- Gun / Melee
    Teleport = true,
    WallPenetration = true,
    AutoFire = true,
    SilentAim = false,
    Range = 800,
    TeleportDist = 8,
    AimPart = "Head",
    Prediction = 0.12,
    FireDelay = 0.15,
    MeleeDelay = 0.4
}

local LastFire = 0

local function GetAimPos(player)
    local char = player.Character
    if not char then return nil end
    local part = char:FindFirstChild(Ragebot.AimPart) or char:FindFirstChild("HumanoidRootPart")
    if not part then return nil end
    return part.Position
end

local function TeleportTo(pos)
    if not RootPart or not pos then return end
    pcall(function()
        local dir = (pos - RootPart.Position).Unit * Ragebot.TeleportDist
        RootPart.CFrame = CFrame.new(pos - dir)
    end)
end

local function FireAt(target)
    if not target or not LocalCharacter then return end
    local tool = LocalCharacter:FindFirstChildWhichIsA("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
    -- Fire remote
    pcall(function()
        local rem = ReplicatedStorage:FindFirstChild("RemoteEvent") or ReplicatedStorage:FindFirstChild("MainEvent")
        if rem then rem:FireServer(target, GetAimPos(target)) end
    end)
end

local function UpdateRagebot()
    if not RootPart or not Humanoid or Humanoid.Health <= 0 or not Ragebot.Enabled then return end
    
    local target = GetClosestEnemy(Ragebot.Range)
    if not target then return end
    local aimPos = GetAimPos(target)
    if not aimPos then return end
    
    -- Teleport
    if Ragebot.Teleport then TeleportTo(aimPos); aimPos = GetAimPos(target) end
    
    -- Silent Aim
    if Ragebot.SilentAim then
        pcall(function() Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPos) end)
    end
    
    -- Auto Fire
    local now = os.clock()
    local delay = Ragebot.Mode == "Melee" and Ragebot.MeleeDelay or Ragebot.FireDelay
    if Ragebot.AutoFire and now - LastFire >= delay then
        LastFire = now
        FireAt(target)
    end
end

