-- =============================================================================
-- OBSIDIAN UI LIBRARY
-- =============================================================================
local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local Library, ThemeManager, SaveManager, LoadErr

local function LoadUI()
    local success, result = pcall(function()
        return loadstring(game:HttpGet(repo .. "Library.lua"))()
    end)
    if not success or not result then
        return nil, nil, nil, "Failed to load Obsidian Library"
    end
    local lib = result
    local tmSuccess, tmResult = pcall(function() return loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))() end)
    local smSuccess, smResult = pcall(function() return loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))() end)
    return lib, (tmSuccess and tmResult) or nil, (smSuccess and smResult) or nil, nil
end

Library, ThemeManager, SaveManager, LoadErr = LoadUI()

