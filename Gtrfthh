    warn("========================================")
end

-- =============================================================================
-- HELPERS
-- =============================================================================
local function KillConn(key)
    if Connections[key] then Connections[key]:Disconnect(); Connections[key] = nil end
end

local function BindCharacter(c)
    LocalCharacter = c
    RootPart = c:WaitForChild("HumanoidRootPart", 5)
    Humanoid = c:WaitForChild("Humanoid", 5)
end

if LocalPlayer.Character then BindCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(BindCharacter)
LocalPlayer.CharacterRemoving:Connect(function()
    for k in pairs(Connections) do KillConn(k) end
    LocalCharacter, RootPart, Humanoid = nil, nil, nil
end)

local function GetClosestPlayer()
    if not RootPart then return nil end
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d = (RootPart.Position - hrp.Position).Magnitude
            if d < bestDist then bestDist, best = d, p end
        end
    end
    return best
end

-- =============================================================================
-- 1. VOID SPAM — ABSOLUTE MAX: 1,000,000 studs/s
-- =============================================================================
local VoidConfig = {Enabled = false, Speed = 100000, Altitude = 1000000000000}

local function StartVoid()
    KillConn("void")
    Connections.void = RunService.Heartbeat:Connect(function()
        if not VoidConfig.Enabled or not RootPart then KillConn("void"); return end
        local pos = RootPart.Position
        RootPart.CFrame = CFrame.new(pos.X, VoidConfig.Altitude, pos.Z)
        RootPart.AssemblyLinearVelocity = Vector3.new(
            (math.random()-0.5) * VoidConfig.Speed,
            (math.random()-0.5) * VoidConfig.Speed,
            (math.random()-0.5) * VoidConfig.Speed
        )
    end)
end
local function StopVoid() KillConn("void") end

-- =============================================================================
-- 2. ORBIT — ABSOLUTE MAX: 10,800°/s • Radius 100,000 studs
-- =============================================================================
local OrbitConfig = {Enabled = false, Speed = 3600, Radius = 10000, Height = 0}
local OrbitAngle = 0

local function StartOrbit()
    KillConn("orbit")
    if Humanoid then Humanoid:ChangeState(Enum.HumanoidStateType.Physics) end
    Connections.orbit = RunService.Heartbeat:Connect(function(dt)
        if not OrbitConfig.Enabled or not RootPart then KillConn("orbit"); return end
        local target = GetClosestPlayer()
        if not target or not target.Character then return end
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        OrbitAngle += math.rad(OrbitConfig.Speed) * dt
        local x = math.cos(OrbitAngle) * OrbitConfig.Radius
        local z = math.sin(OrbitAngle) * OrbitConfig.Radius
        RootPart.CFrame = CFrame.new(hrp.Position + Vector3.new(x, OrbitConfig.Height, z))
    end)
end
local function StopOrbit() KillConn("orbit") end

-- =============================================================================
-- 3. TRANSLOCATE — ABSOLUTE MAX: 500,000 studs range
-- =============================================================================
local TranslocateConfig = {Enabled = false, Range = 100000, Offset = 5}

local function StartTranslocate()
    KillConn("translocate")
    Connections.translocate = RunService.Heartbeat:Connect(function()
        if not TranslocateConfig.Enabled or not RootPart then KillConn("translocate"); return end
        local target = GetClosestPlayer()
        if not target or not target.Character then return end
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local dist = (RootPart.Position - hrp.Position).Magnitude
        if dist <= TranslocateConfig.Range then
            local dir = (hrp.Position - RootPart.Position).Unit * TranslocateConfig.Offset
            RootPart.CFrame = CFrame.new(hrp.Position - dir)
        end
    end)
end
local function StopTranslocate() KillConn("translocate") end

-- =============================================================================
-- 4. EVADE — ABSOLUTE MAX: 10,000,000 studs distance
-- =============================================================================
local EvadeConfig = {Enabled = false, Distance = 1000000, Delay = 1}

local function EvadeOnce()
    if not RootPart then return end
    local a = math.random() * math.pi * 2
    RootPart.CFrame = CFrame.new(
        RootPart.Position + Vector3.new(
            math.cos(a) * EvadeConfig.Distance,
            math.random(-EvadeConfig.Distance/4, EvadeConfig.Distance/4),
            math.sin(a) * EvadeConfig.Distance
        )
    )
end

local function StartEvade()
    EvadeConfig.Enabled = true
    task.spawn(function()
        while EvadeConfig.Enabled do
            task.wait(EvadeConfig.Delay)
            if not EvadeConfig.Enabled then break end
            EvadeOnce()
        end
    end)
end
local function StopEvade() EvadeConfig.Enabled = false end

-- =============================================================================
-- 5. VOID HIDE — ABSOLUTE MAX: 10,000,000,000 studs high
-- =============================================================================
local VoidHideConfig = {Enabled = false, Height = 1000000000, GhostMode = true, OriginalTransparency = {}}
local OriginalParent = nil

local function HideCharacter()
    if not LocalCharacter then return end
    VoidHideConfig.OriginalTransparency = {}
    OriginalParent = LocalCharacter.Parent
    for _, d in ipairs(LocalCharacter:GetDescendants()) do
        if d:IsA("BasePart") then
            VoidHideConfig.OriginalTransparency[d] = d.Transparency
            d.Transparency = VoidHideConfig.GhostMode and 0.5 or 1
            d.CanCollide = false
        end
    end
    LocalCharacter.Parent = workspace.Terrain
    if RootPart then
        RootPart.CFrame = CFrame.new(0, VoidHideConfig.Height, 0)
    end
end

local function ShowCharacter()
    if not LocalCharacter then return end
    for d, origTrans in pairs(VoidHideConfig.OriginalTransparency) do
        if d and d:IsDescendantOf(workspace) then
            d.Transparency = origTrans
            d.CanCollide = true
        end
    end
    VoidHideConfig.OriginalTransparency = {}
    LocalCharacter.Parent = OriginalParent
end

local function StartVoidHide()
    KillConn("voidhide")
    HideCharacter()
    Connections.voidhide = RunService.Heartbeat:Connect(function()
        if not VoidHideConfig.Enabled then KillConn("voidhide"); ShowCharacter(); return end
        if not RootPart then return end
        RootPart.CFrame = CFrame.new(0, VoidHideConfig.Height, 0)
    end)
end
local function StopVoidHide()
    VoidHideConfig.Enabled = false
    KillConn("voidhide")
    ShowCharacter()
end

