        VoidKillerConfig.Enabled = not VoidKillerConfig.Enabled
        print("[⚔️ VOID KILLER]:", VoidKillerConfig.Enabled and "✅ ON" or "❌ OFF")
    elseif k == Enum.KeyCode.Zero then
        EvadeOnce()
        print("[⚡ EVADE NOW!]")
    elseif k == Enum.KeyCode.M then
        RagebotConfig.Mode = RagebotConfig.Mode == "Gun" and "Melee" or "Gun"
        print("[🔫 MODE]:", RagebotConfig.Mode)
    end
end)

