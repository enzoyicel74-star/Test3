-- 2. ORBIT
-- =============================================================================
local OrbitConfig = {Enabled = false, Speed = 360, Radius = 30, Height = 5, Tilt = 0, Range = 500, UsePrediction = true}
local OrbitAngle = 0
local function UpdateOrbit(dt)
    if not RootPart or not OrbitConfig.Enabled then return end
    local target = GetClosestPlayer(OrbitConfig.Range)
    if not target then return end
    local targetPos = OrbitConfig.UsePrediction and PredictionConfig.Enabled and GetPredictedPosition(target) or (target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character.HumanoidRootPart.Position)
    if not targetPos then return end
    OrbitAngle += math.rad(OrbitConfig.Speed) * dt
    local x, z = math.cos(OrbitAngle)*OrbitConfig.Radius, math.sin(OrbitAngle)*OrbitConfig.Radius
    pcall(function() RootPart.CFrame = CFrame.new(targetPos + Vector3.new(x, OrbitConfig.Height, z)) end)
end

-- =============================================================================
-- 3. TRANSLOCATE
-- =============================================================================
local TranslocateConfig = {Enabled = false, Range = 1000, Offset = 8, MinDistance = 15, Lift = 0, UsePrediction = true}
local function UpdateTranslocate()
    if not RootPart or not TranslocateConfig.Enabled then return end
    local target = GetClosestPlayer(TranslocateConfig.Range)
    if not target then return end
    local targetPos = TranslocateConfig.UsePrediction and PredictionConfig.Enabled and GetPredictedPosition(target) or (target.Character and target.Character:FindFirstChild("HumanoidRootPart") and target.Character.HumanoidRootPart.Position)
    if not targetPos then return end
    local dist = (RootPart.Position - targetPos).Magnitude
    if dist < TranslocateConfig.MinDistance then return end
    pcall(function()
        local dir = (targetPos - RootPart.Position).Unit * TranslocateConfig.Offset
        RootPart.CFrame = CFrame.new(targetPos - dir + Vector3.new(0, TranslocateConfig.Lift, 0))
    end)
end

