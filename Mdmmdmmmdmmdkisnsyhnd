-- 🛡️ ANTI AIM
-- =============================================================================
local AntiAimConfig = {
    Enabled = false,
    Mode = "Spin",
    SpinSpeed = 180,
    JitterAmount = 45,
    BackwardsOffset = 180,
    Randomize = true
}
local AntiAimAngle = 0

local function UpdateAntiAim(dt)
    if not RootPart or not AntiAimConfig.Enabled then return end
    AntiAimAngle += math.rad(AntiAimConfig.SpinSpeed) * dt
    local finalAngle = 0
    if AntiAimConfig.Mode == "Spin" then
        finalAngle = AntiAimAngle
    elseif AntiAimConfig.Mode == "Jitter" then
        finalAngle = math.rad(math.sin(os.clock() * 10) * AntiAimConfig.JitterAmount)
        if AntiAimConfig.Randomize then
            finalAngle += math.rad(math.random(-15, 15))
        end
    elseif AntiAimConfig.Mode == "Backwards" then
        finalAngle = math.rad(AntiAimConfig.BackwardsOffset + (AntiAimConfig.Randomize and math.random(-15, 15) or 0))
    end
    pcall(function()
        RootPart.CFrame = CFrame.new(RootPart.Position, RootPart.Position + Vector3.new(math.cos(finalAngle), 0, math.sin(finalAngle)))
    end)
end

