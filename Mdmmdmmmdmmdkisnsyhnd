-- 4. EVADE
-- =============================================================================
local EvadeConfig = {Enabled = false, Distance = 200, Delay = 1.5, MinHeight = -50, MaxHeight = 150, Direction = 360}
local LastEvade = os.clock()
local function EvadeOnce()
    if not RootPart then return end
    LastEvade = os.clock()
    local angle = EvadeConfig.Direction == 360 and math.random() * math.pi * 2 or math.rad(EvadeConfig.Direction)
    pcall(function() RootPart.CFrame = CFrame.new(RootPart.Position + Vector3.new(math.cos(angle)*EvadeConfig.Distance, math.random(EvadeConfig.MinHeight, EvadeConfig.MaxHeight), math.sin(angle)*EvadeConfig.Distance)) end)
end
local function UpdateEvade()
    if not RootPart or not EvadeConfig.Enabled then return end
    if os.clock() - LastEvade >= EvadeConfig.Delay then EvadeOnce() end
end

