-- Get Current Equipped Tool/Weapon
local function GetEquippedTool()
    if not LocalCharacter then return nil end
    return LocalCharacter:FindFirstChildWhichIsA("Tool")
end

-- Get Aim Position (with prediction)
local function GetAimPosition(player)
    local char = player.Character
    if not char then return nil end
    local part = char:FindFirstChild(RagebotConfig.AimPart) or char:FindFirstChild("HumanoidRootPart")
    if not part then return nil end
    
    -- Apply prediction if enabled
    if PredictionConfig.Enabled then
        local predicted = GetPredictedPosition(player, RagebotConfig.PredictionAmount)
        return predicted or part.Position
    end
    return part.Position
end

-- FIRE WEAPON / ATTACK — ACTUALLY WORKS
local function FireWeapon(target)
    if not target or not LocalCharacter then return end
    
    local aimPos = GetAimPosition(target)
    if not aimPos then return end
    
    local tool = GetEquippedTool()
    
    -- GUN MODE
    if RagebotConfig.Mode == "Gun" then
        if tool then
            pcall(function()
                -- Fire tool (most games use Activate)
                tool:Activate()
            end)
        end
        
        -- Fire via RemoteEvent (common in many games)
        pcall(function()
            local Remote = ReplicatedStorage:FindFirstChild("RemoteEvent") or 
                          ReplicatedStorage:FindFirstChild("MainEvent") or
                          LocalPlayer.PlayerScripts:FindFirstChild("RemoteEvent")
            if Remote then
                Remote:FireServer(target, aimPos, "Fire")
            end
        end)
        
        -- Direct mouse click simulation
        pcall(function()
            UserInputService:InputBegan({
                UserInputType = Enum.UserInputType.MouseButton1,
                GameProcessedEvent = false
            })
            task.wait(0.05)
            UserInputService:InputEnded({
                UserInputType = Enum.UserInputType.MouseButton1,
                GameProcessedEvent = false
            })
        end)
    
    -- MELEE MODE
    elseif RagebotConfig.Mode == "Melee" then
        if tool then
            pcall(function()
                tool:Activate()
                tool:Deactivate()
            end)
        end
        
        -- Melee attack via remote
        pcall(function()
            local Remote = ReplicatedStorage:FindFirstChild("RemoteEvent") or ReplicatedStorage:FindFirstChild("MeleeEvent")
            if Remote then
                Remote:FireServer(target, aimPos, "Melee")
            end
        end)
    end
end

-- TELEPORT TO TARGET
local function TeleportToTarget(targetPos)
    if not RootPart or not targetPos then return end
    pcall(function()
        local dir = (targetPos - RootPart.Position).Unit * RagebotConfig.TeleportDistance
        RootPart.CFrame = CFrame.new(targetPos - dir)
    end)
end

-- SILENT AIM — Override camera aim without moving your view
local function ApplySilentAim(targetPos)
    if not RagebotConfig.SilentAim or not RootPart then return end
    pcall(function()
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
    end)
end

-- RAGEBOT MAIN — RUNS EVERY FRAME
local function UpdateRagebot()
    if not RootPart or not Humanoid or Humanoid.Health <= 0 then return end
    if not RagebotConfig.Enabled then return end
    
    local target = GetClosestPlayer(RagebotConfig.Range)
    if not target then return end
    
    local aimPos = GetAimPosition(target)
    if not aimPos then return end
    
    -- Check line of sight (unless wall penetration is on)
    local canShoot = true
    if not RagebotConfig.WallPenetration then
        canShoot = HasLineOfSight(RootPart.Position, aimPos)
    end
    
    -- Teleport
    if RagebotConfig.Teleport then
        TeleportToTarget(aimPos)
        aimPos = GetAimPosition(target) -- Refresh after teleport
    end
    
    -- Silent Aim
    if RagebotConfig.SilentAim then
        ApplySilentAim(aimPos)
    end
    
    -- Auto Fire
    if RagebotConfig.AutoFire and canShoot then
        local now = os.clock()
        local delay = RagebotConfig.Mode == "Melee" and RagebotConfig.MeleeDelay or RagebotConfig.FireDelay
        if now - LastFire >= delay then
            LastFire = now
            FireWeapon(target)
        end
    end
end

-- =============================================================================
-- 🎯 PREDICTION SYSTEM
-- =============================================================================
local PredictionConfig = {
    Enabled = true,
    Amount = 0.12,
    VelocityBased = true,
    Vertical = true,
    Smoothness = 0.8
}
local PlayerVelocity = {}

local function UpdatePlayerVelocity(player)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local state = PlayerVelocity[player] or {LastPos = hrp.Position, LastTime = os.clock(), Velocity = Vector3.new()}
    local now = os.clock()
    local dt = now - state.LastTime
    if dt > 0 and dt < 1 then
        state.Velocity = (hrp.Position - state.LastPos) / dt
    end
    state.LastPos = hrp.Position
    state.LastTime = now
    PlayerVelocity[player] = state
end

local function GetPredictedPosition(player, timeOffset)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    UpdatePlayerVelocity(player)
    local state = PlayerVelocity[player]
    if not state or not state.Velocity or state.Velocity.Magnitude < 0.1 then
        return hrp.Position
    end
    local predicted = hrp.Position + state.Velocity * (timeOffset or PredictionConfig.Amount)
    if not PredictionConfig.Vertical then
        predicted = Vector3.new(predicted.X, hrp.Position.Y, predicted.Z)
    end
    return predicted
end

