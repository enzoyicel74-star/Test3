    elseif k == Enum.KeyCode.Three then
        AntiAimConfig.Enabled = not AntiAimConfig.Enabled
        print("[🛡️ ANTI AIM]:", AntiAimConfig.Enabled and "✅ ON" or "❌ OFF")
    elseif k == Enum.KeyCode.Four then
        VoidConfig.Enabled = not VoidConfig.Enabled
        print("[⬆️ VOID SPAM]:", VoidConfig.Enabled and "✅ ON" or "❌ OFF")
    elseif k == Enum.KeyCode.Five then
        OrbitConfig.Enabled = not OrbitConfig.Enabled
        print("[🌀 ORBIT]:", OrbitConfig.Enabled and "✅ ON" or "❌ OFF")
    elseif k == Enum.KeyCode.Six then
        TranslocateConfig.Enabled = not TranslocateConfig.Enabled
        print("[🎯 TRANSLOCATE]:", TranslocateConfig.Enabled and "✅ ON" or "❌ OFF")
    elseif k == Enum.KeyCode.Seven then
        EvadeConfig.Enabled = not EvadeConfig.Enabled
        print("[💨 EVADE]:", EvadeConfig.Enabled and "✅ ON" or "❌ OFF")
    elseif k == Enum.KeyCode.Eight then
        VoidHideConfig.Enabled = not VoidHideConfig.Enabled
        if not VoidHideConfig.Enabled and OriginalParent then ShowCharacter() end
        print("[👻 VOID HIDE]:", VoidHideConfig.Enabled and "✅ ON" or "❌ OFF")
